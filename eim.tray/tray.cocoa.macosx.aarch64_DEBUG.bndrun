-include: ~eim.tray.shared.bndrun

-runvm: -XstartOnFirstThread\n\
	-Djava.awt.headless=true\n\
	-Dorg.eclipse.swt.internal.carbon.smallFonts

-runblacklist.macos: \
    osgi.identity;filter:='(osgi.identity=*linux*)',\
    osgi.identity;filter:='(osgi.identity=*win32*)',\
    osgi.identity;filter:='(osgi.identity=*macosx.x86_64*)'
    
-runrequires.macos: \
    bnd.identity;id='org.eclipse.swt.cocoa.macosx.aarch64'

-runsystemcapabilities.macos: \
    osgi.native;osgi.native.osname:List<String>="macosx";osgi.native.processor:List<String>="aarch64"
    
-runproperties.macosx: \
    osgi.ws=cocoa,\
    osgi.arch=aarch64,\
    osgi.os=macosx,\
    osgi.console=,\
    launch.debug=true

-runrequires.debug: \
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.runtime',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.eclipse.ecf.provider.filetransfer.httpclient5',\
	bnd.identity;id='org.eclipse.ecf.provider.filetransfer.httpclientjava'

#	bnd.identity;id='org.eclipse.e4.ui.di',\
#	bnd.identity;id='org.eclipse.equinox.event',\
#	bnd.identity;id='org.osgi.service.event'

