-runfw: org.eclipse.osgi;version='[3.23,4)'
-runee: JavaSE-17
-resolve.effective: active

-runproperties: \
	launch.keep=false,\
	org.osgi.framework.bootdelegation='org.xml.*,javax.management,javax.net,javax.net.ssl',\
	logback.configurationFile=logback.xml

-runbundles+: \
	ch.qos.logback.classic;startlevel=2,\
	org.apache.aries.spifly.dynamic.bundle;startlevel=2,\
	org.apache.felix.scr;startlevel=2,\
	org.eclipse.equinox.common;startlevel=2,\
	org.apache.felix.gogo.command;startlevel=3,\
	org.apache.felix.gogo.runtime;startlevel=3,\
	org.apache.felix.gogo.shell;startlevel=3,\
	\
	org.apache.felix.http.jetty;startlevel=5,\
	org.osgi.service.http.whiteboard;startlevel=6,\
	org.apache.felix.webconsole;startlevel=7,\
	\
	*;startlevel=10

-runblacklist: \
	bnd.identity;id='org.osgi.compendium',\
	bnd.identity;id='osgi.cmpn'

#    bnd.identity;id='eim.tray',\

-runrequires: \
    bnd.identity;id='eim.api',\
    bnd.identity;id='eim.impl',\
    bnd.identity;id='ch.qos.logback.classic',\
    bnd.identity;id='ch.qos.logback.core',\
    bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
    bnd.identity;id='org.eclipse.equinox.preferences'
