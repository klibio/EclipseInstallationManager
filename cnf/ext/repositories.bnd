releaserepo:         ${workspace}/dist/bundles
# local maven repo server
reposilite_release:  https://releases.reposilite.klib.io/releases
reposilite_snapshot: https://snapshots.reposilite.klib.io/snapshots
# internet maven repo server
mavencentral:        https://repo.maven.apache.org/maven2/
sonatype_release:    https://central.sonatype.com/api/v1/publisher/upload/
sonatype_snapshots:  https://central.sonatype.com/repository/maven-snapshots/

-buildrepo: Local

#-releaserepo: Rel_Local,Rel_Reposilite,Rel_Sonatype
-releaserepo: Rel_Local
#-releaserepo: Rel_Reposilite
#-releaserepo: Rel_Sonatype

-plugin.0.Main:\
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        name="Local";\
        noupdateOnRelease=true

-plugin.10.AddOns: \
    aQute.bnd.deployer.repository.LocalIndexedRepo; \
        name = AddOns; \
        pretty = true; \
        local = ${build}/addons
        
-plugin.90.LocalRelease:\
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        releaseUrl  = "${fileuri;${releaserepo}}";\
        snapshotUrl = "${fileuri;${releaserepo}}";\
        name        = "Rel_Local";\
        noupdateOnRelease=true

# configure access credentials to server
-connection-settings.reposilite:\
   server;    id = ${reposilite_release};\
        username = ${reposilite_release_user};\
        password = ${reposilite_release_token};\
          verify = false,\
   server; 	  id = ${reposilite_snapshot};\
        username = ${reposilite_snapshot_user};\
        password = ${reposilite_snapshot_token};\
          verify = false

-plugin.91.reposilite: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl = ${reposilite_snapshot}; \
        releaseUrl	= ${reposilite_release}; \
        index       = ${.}/gav_91_reposilite.mvn; \
        name        = "Rel_Reposilite"

-connection-settings.sonatype:\
   server;    id = ${sonatype_release};\
        password = ${sonatype_bearer};\
          verify = false,\
   server;    id = ${sonatype_snapshots};\
        password = ${sonatype_bearer};\
          verify = false

-plugin.92.sonatype: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl = ${sonatype_snapshots};\
        releaseUrl  = ${sonatype_release}; \
        index       = ${.}/gav_92_sonatype.mvn; \
        name        = "Rel_Sonatype"; \
        autopublish = false


-plugin.6.Central: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        releaseUrl=https://repo.maven.apache.org/maven2/; \
        index=${.}/central.maven; \
        readOnly=true; \
        name="Maven Central"

-plugin.8.Templates: \
    aQute.bnd.deployer.repository.LocalIndexedRepo; \
        name = Templates; \
        pretty = true; \
        local = ${build}/templates
        
# eclipse release details
eclipse.url              = https://download.eclipse.org

# Eclipse Platform release 
eclipse.version          = 4.36
eclipse.platform.version = R-4.36-202505281830
# Eclipse Platform release - do not edit - derived variables
eclipse.platform.baseurl = ${eclipse.url}/eclipse/updates
eclipse.platform.name    = Platform_${eclipse.platform.version}
eclipse.platform.url     = "${eclipse.platform.baseurl}/${eclipse.version}/${eclipse.platform.version}"

-plugin.10.eclipse.platform: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name  = ${eclipse.platform.name}; \
        url   = ${eclipse.platform.url}

# Eclipse Simultaneous release 
eclipse.name             = 2025-06
eclipse.simu.version     = 202506111000
# Eclipse Simultaneous release- do not edit - derived variables
eclipse.simu.baseurl     = ${eclipse.url}/releases
eclipse.simu.name        = "SimuRel_${eclipse.name}_${eclipse.simu.version}"
eclipse.simu.url         = "${eclipse.simu.baseurl}/${eclipse.name}/${eclipse.simu.version}"
 
# uncomment the following line to include the simultaneous release
#-plugin.11.eclipse.simu: \
#    aQute.bnd.repository.p2.provider.P2Repository; \
#        name  = ${eclipse.simu.name}; \
#        url   = ${eclipse.simu.url}

oomph.version=1.37.0
-plugin.11.oomph.platform: \
    aQute.bnd.repository.p2.provider.P2Repository; \
        name  = "Oomph ${oomph.version}"; \
        url   = "${eclipse.url}/oomph/drops/release/${oomph.version}/"
